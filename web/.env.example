# Trace-Point Frontend Configuration
# Backend API URL for development proxy
VITE_BACKEND_URL=http://localhost:8088

# Uncomment if running in Docker with custom network
# VITE_BACKEND_URL=http://backend:8088

# Uncomment if backend is running on a different host/port
# VITE_BACKEND_URL=http://192.168.1.173:8088
